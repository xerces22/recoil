[node name="RottenShelves" type="Node2D"]
editor_description = "Floor 5. New: crumbling shelves. Switchback: leg 1 left over safe floor, leg 2 right above a spiked divider into a waiting lift, leg 3 left on fast crumbles. See LEVEL_LOG.md."
