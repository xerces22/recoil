[node name="Sandwitch" type="Node2D"]
editor_description = "Floor 10 (finale, combos). A: crumbles over a pit with a gargoyle shooting the gap, a lift. B: slider over a spiked shelf, door hop off the slider, wisp and fast crumble over a spiked gate top. C: zigzag, wisp, crumble, a lift under an aimed gargoyle, door hop into the walled orb room. See LEVEL_LOG.md."
script = ExtResource("level")
title = "Mrs. Sandwitch"
hint = "Nothing new. Everything you've learned, at the same time. The orb is at the top."
taunt = "Fine. Come on up. I've got my wand ready."
is_final = true
