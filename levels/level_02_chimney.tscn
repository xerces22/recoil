[node name="Chimney" type="Node2D"]
editor_description = "Floor 2. New: shell wisps. A: one wisp lifts you to a ledge you can't reach with two shells. B: wisps carry you across a spike pit. C: the Chimney, a diagonal tunnel going up-left with a spiked floor, wisps down the middle. See LEVEL_LOG.md."
script = ExtResource("level")
title = "The Chimney"
hint = "Gold wisps reload your shells in midair. Fly through one, then shoot again."
