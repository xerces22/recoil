[node name="GargoyleGallery" type="Node2D"]
editor_description = "Floor 6 (exam). New: gargoyles. Corridor 1 right: islands over spike patches, a gargoyle firing down the corridor. Corridor 2 left: a long slider over spikes under two gargoyles firing down. Corridor 3 right: crumbles and an aimed gargoyle. See LEVEL_LOG.md."
script = ExtResource("level")
title = "Gargoyle Gallery"
hint = "Gargoyle bolts don't hurt. They shove you, and the spikes do the rest. Watch the glow before each shot."
