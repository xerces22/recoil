[node name="MindTheDoors" type="Node2D" unique_id=409042885]
editor_description = "Floor 7. New: mimic doors. A: one gate, one slow door. B: a gate with two doors out of step. C: a sideways door in a corridor going left over spikes, then two gates 100 px apart. See LEVEL_LOG.md."
script = ExtResource("level")
title = "Mind the Doors"
hint = "Mimic doors snap shut on a beat. Watch them shake, then go. If one bites you, it eats your shells."
taunt = "My doors are hungry. You look crunchy."
bounds = Rect2(0, -962, 2560, 1682)

